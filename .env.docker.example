# ==============================================================================
# CloudDeploy AI — Docker Compose Environment Template (.env)
# Copy this file to .env before starting docker-compose:
#   cp .env.docker.example .env
# ==============================================================================

# Database Security (MANDATORY — Replace with your own secure passwords)
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# JWT Authentication Security (MANDATORY — Generate a 256-bit+ random secret)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Optional AI Configuration (Unconfigured by default with clean 503 fallback)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# Optional AWS S3 Configuration (Unconfigured by default with clean 503 fallback)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_URL_DURATION=15
